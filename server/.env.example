# =============================================================================
# Cloud Provider Configuration (Phase 3 — Multi-Cloud)
# =============================================================================
# Controls which cloud provider the platform uses at runtime.
# Options: MockCloud (default) | AWS | Azure | GCP
# Providers fall back to MockCloudProvider if credentials are missing.
AWS_REGION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_ROLE_ARN=
AWS_EXTERNAL_ID=

CLOUD_PROVIDER=AWS
# Azure Credentials (required when CLOUD_PROVIDER=Azure)
# Use a Service Principal with Contributor role on the target subscription
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GCP Credentials (required when CLOUD_PROVIDER=GCP)
# Use a Service Account with Compute Viewer + Monitoring Viewer roles
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=  # Absolute path to service account JSON key file

# =============================================================================
# AI Copilot & NVIDIA Build API Configuration (Engineer 3)
# =============================================================================
# AI Provider: nvidia (default with NVIDIA Build API) | gemini | mock

PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="cloudops_hackathon_jwt_super_secret_key_2026"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# AI Copilot Configuration (NVIDIA Build API / Gemma 2 / Mock fallback)
AI_PROVIDER="nvidia"
NVIDIA_API_KEY=
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Preferred Model: google/gemma-4-31b-it | google/gemma-3-12b-it | meta/llama-3.2-11b-vision-instruct | meta/llama-3.3-70b-instruct
NVIDIA_MODEL="google/gemma-4-31b-it"
NVIDIA_TEMPERATURE="0.2"
NVIDIA_MAX_TOKENS="1024"

AZURE_SUBSCRIPTION_ID="<your-azure-subscription-id>"
AZURE_TENANT_ID="<your-entra-id-tenant-id>"
AZURE_CLIENT_ID="<your-service-principal-app-id>"
AZURE_CLIENT_SECRET="<your-service-principal-client-secret>"
