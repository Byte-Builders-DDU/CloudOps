PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="cloudops_hackathon_jwt_super_secret_key_2026"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"

# =============================================================================
# Cloud Provider Configuration (Phase 2 — AWS Integration)
# =============================================================================
# Controls which cloud provider the platform uses at runtime.
# Change to 'AWS' to activate live AWS SDK integration.
# Default: MockCloud (simulation engine, no credentials required)
CLOUD_PROVIDER=MockCloud

# AWS Credentials (required when CLOUD_PROVIDER=AWS)
# Use an IAM user with AmazonEC2ReadOnlyAccess + CloudWatchReadOnlyAccess + AutoScalingFullAccess
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS STS AssumeRole — Optional, for multi-account management
# Leave blank if using single-account IAM credentials
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=
